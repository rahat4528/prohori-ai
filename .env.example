# ==============================================================================
# Prohori AI Configuration Example (.env)
# Copy this file to .env and adjust variables as needed for your environment.
# Note: Zero real secrets or production credentials should be committed here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Default: Automatic SQLite fallback for zero-friction local developer setup.
DATABASE_URL=sqlite+aiosqlite:///prohori.db
# For local Docker PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohori
# For Supabase cloud:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prohori

# ------------------------------------------------------------------------------
# 2. Server & Event Bus Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Sensor Communication Endpoints
EVENT_API_URL=http://localhost:8000
UPSTREAM_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. API Security & Write Protection (Opt-In)
# ------------------------------------------------------------------------------
# Protects write endpoints: POST /events, POST /audit/approve, POST /sovereignty/toggle.
# Leave empty for open demo mode (prints a startup warning).
# Set to enforce strict header authentication: X-API-Key: <PROHORI_API_KEY>
PROHORI_API_KEY=
VITE_PROHORI_API_KEY=

# ------------------------------------------------------------------------------
# 4. AI Engine & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider Choice: "ollama" (local sovereign), "offline" (deterministic rules), "gemini" (cloud), "groq" (cloud), or "auto"
LLM_PROVIDER=ollama

# Local Ollama Daemon (Default Data-Sovereignty Engine: zero cloud egress)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180.0
OLLAMA_NUM_PREDICT=1000

# Google Gemini Cloud API (Optional alternative for stage demo speed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud API (Optional alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. Defensive Sensor Parameters
# ------------------------------------------------------------------------------
# Asset Discovery Scanner: Strict allowlisted IP ranges/CIDRs
DISCOVERY_ALLOWLIST=127.0.0.1,localhost,192.168.1.0/24

# API Abuse Guard (Rate Limiter) Sliding-Window Parameters
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_MAX_REQUESTS=10
TEMP_BLOCK_SEC=30
EXTENDED_BLOCK_SEC=180

# ------------------------------------------------------------------------------
# 6. React Operator Console Frontend (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/stream
