# ==============================================================================
# Prohori AI Configuration Example (.env)
# Copy to .env and adjust variables as needed
# ==============================================================================

# Database Configuration
# Local SQLite fallback is used automatically when Postgres is not running.
# For local Docker pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohori
# For Supabase cloud:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///prohori.db

# Postgres Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prohori

# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Providers Configuration
# Google Gemini API (Recommended cloud provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud API (Optional alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Offline Sovereignty LLM (Zero cloud egress)
# Prohori automatically falls back to Deterministic Offline RAG if Ollama is not running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
