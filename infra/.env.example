# ==============================================================================
# Prohori AI - Infrastructure & Docker Compose Environment (.env)
# Copy this file to infra/.env or root .env when deploying via docker compose.
# ==============================================================================

# 1. Database: Docker Compose PostgreSQL service with pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/prohori
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prohori

# 2. Server Configuration
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
EVENT_API_URL=http://api:8000
UPSTREAM_URL=http://api:8000

# 3. API Security
PROHORI_API_KEY=
VITE_PROHORI_API_KEY=

# 4. LLM Providers
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180.0
OLLAMA_NUM_PREDICT=1000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Defensive Sensor Parameters
DISCOVERY_ALLOWLIST=127.0.0.1,localhost,172.20.0.0/16
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_MAX_REQUESTS=10
TEMP_BLOCK_SEC=30
EXTENDED_BLOCK_SEC=180

# 6. Web Console
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/stream
