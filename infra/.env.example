# Prohori AI Configuration Example
# Copy to .env and adjust variables as needed

# Database: Local Docker pgvector or Supabase connection string
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/prohori
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohori

# Postgres credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prohori

# Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# LLM Providers (for Module 3)
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

